# Application
XBRL_ENV=development
XBRL_LOG_LEVEL=INFO
XBRL_DATA_DIR=./data
XBRL_TEMP_DIR=./data/tmp
XBRL_CONFIG_DIR=./config

# Required for all SEC traffic. Replace this value before making requests.
XBRL_SEC_USER_AGENT=Your Name or Organization monitored-email@example.com
XBRL_SEC_MAX_REQUESTS_PER_SECOND=8
XBRL_SEC_MAX_CONCURRENCY=4
XBRL_SEC_CONNECT_TIMEOUT_SECONDS=20
XBRL_SEC_READ_TIMEOUT_SECONDS=120
XBRL_SEC_MAX_RETRIES=6

# PostgreSQL control plane
POSTGRES_DB=xbrl_control
POSTGRES_USER=xbrl
POSTGRES_PASSWORD=xbrl_dev_password
POSTGRES_PORT=5432
XBRL_POSTGRES_DSN=postgresql+asyncpg://xbrl:xbrl_dev_password@localhost:5432/xbrl_control

# ClickHouse analytical warehouse
CLICKHOUSE_DB=xbrl
CLICKHOUSE_USER=xbrl
CLICKHOUSE_PASSWORD=xbrl_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
XBRL_CLICKHOUSE_HOST=localhost
XBRL_CLICKHOUSE_PORT=8123
XBRL_CLICKHOUSE_DATABASE=xbrl
XBRL_CLICKHOUSE_USERNAME=xbrl
XBRL_CLICKHOUSE_PASSWORD=xbrl_dev_password
XBRL_CLICKHOUSE_SECURE=false

# S3-compatible object storage / MinIO
# Pin these image tags in production; `latest` is convenient only for local development.
MINIO_IMAGE_TAG=latest
MINIO_MC_IMAGE_TAG=latest
MINIO_ROOT_USER=xbrl_minio
MINIO_ROOT_PASSWORD=xbrl_minio_dev_password
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
XBRL_OBJECT_STORE_BACKEND=s3
XBRL_OBJECT_STORE_ENDPOINT=http://localhost:9002
XBRL_OBJECT_STORE_ACCESS_KEY=xbrl_minio
XBRL_OBJECT_STORE_SECRET_KEY=xbrl_minio_dev_password
XBRL_OBJECT_STORE_BUCKET=sec-xbrl
XBRL_OBJECT_STORE_REGION=us-east-1
XBRL_OBJECT_STORE_SECURE=false

# Parsing and storage
XBRL_ARROW_BATCH_ROWS=50000
XBRL_PARQUET_COMPRESSION=zstd
XBRL_PARQUET_COMPRESSION_LEVEL=6
XBRL_ARELLE_VALIDATE_XBRL=true
XBRL_ARELLE_VALIDATE_EFM=false
XBRL_ARELLE_PLUGIN_PATHS=
XBRL_ARELLE_CACHE_DIR=./data/cache/arelle
XBRL_ARELLE_TAXONOMY_PACKAGES_DIR=./data/taxonomy-packages
XBRL_ARELLE_OFFLINE=false
XBRL_ARELLE_ALLOWED_TAXONOMY_HOSTS=www.sec.gov,xbrl.fasb.org,xbrl.ifrs.org,www.xbrl.org

# Job worker
XBRL_WORKER_ID=local-worker
XBRL_WORKER_POLL_SECONDS=2
XBRL_WORKER_LOCK_TIMEOUT_SECONDS=900
XBRL_WORKER_MAX_ATTEMPTS=5

# API
XBRL_API_HOST=0.0.0.0
XBRL_API_PORT=8080
