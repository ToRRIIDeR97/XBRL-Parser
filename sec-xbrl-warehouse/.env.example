# Application
XBRL_ENV=development
XBRL_LOG_LEVEL=INFO
XBRL_DATA_DIR=./data
XBRL_TEMP_DIR=./data/tmp
XBRL_CONFIG_DIR=./config

# Regulators to fetch from (comma-separated source codes: sec, esef, edinet, dart). Use the same value
# in every worker and CLI process; jobs for a source that isn't enabled fail permanently.
# Before adding esef, confirm filings.xbrl.org reuse terms and pin the ESEF/IFRS
# taxonomies (docs/OPERATIONS.md, "ESEF filings").
XBRL_ENABLED_SOURCES=sec

# ESEF discovery on filings.xbrl.org: records per page, pages per run (per country),
# and ISO country codes to page separately (empty: all countries in one feed).
XBRL_ESEF_PAGE_SIZE=100
XBRL_ESEF_MAX_PAGES=50
XBRL_ESEF_COUNTRIES=

# EDINET (Japan, FSA) and OpenDART (Korea, FSS) API keys: your own, free, per-user
# keys, never shared (the regulators' terms). Required only on workers that fetch
# from that source. Keys go only into outgoing requests, never into stored URLs, logs
# or job payloads. See docs/OPERATIONS.md, "EDINET and DART filings".
XBRL_EDINET_API_KEY=
XBRL_DART_API_KEY=
# EDINET discovery: days per run (one list request per day) and document type codes
# kept when a run names no forms (120/130 annual, 140/150 quarterly, 160/170 half-year).
XBRL_EDINET_MAX_DAYS=31
XBRL_EDINET_DOC_TYPES=120,130,140,150,160,170
# OpenDART disclosure-search page size (1 to 100).
XBRL_DART_PAGE_COUNT=100

# Required for all SEC traffic. Replace this value before making requests.
XBRL_SEC_USER_AGENT=Your Name or Organization monitored-email@example.com
XBRL_SEC_MAX_REQUESTS_PER_SECOND=8
XBRL_SEC_MAX_CONCURRENCY=4
XBRL_SEC_CONNECT_TIMEOUT_SECONDS=20
XBRL_SEC_READ_TIMEOUT_SECONDS=120
XBRL_SEC_MAX_RETRIES=6

# PostgreSQL control plane
POSTGRES_DB=xbrl_control
POSTGRES_USER=xbrl
POSTGRES_PASSWORD=xbrl_dev_password
POSTGRES_PORT=5432
XBRL_POSTGRES_DSN=postgresql+asyncpg://xbrl:xbrl_dev_password@localhost:5432/xbrl_control

# ClickHouse analytical warehouse
CLICKHOUSE_DB=xbrl
CLICKHOUSE_USER=xbrl
CLICKHOUSE_PASSWORD=xbrl_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
XBRL_CLICKHOUSE_HOST=localhost
XBRL_CLICKHOUSE_PORT=8123
XBRL_CLICKHOUSE_DATABASE=xbrl
XBRL_CLICKHOUSE_USERNAME=xbrl
XBRL_CLICKHOUSE_PASSWORD=xbrl_dev_password
XBRL_CLICKHOUSE_SECURE=false

# S3-compatible object storage / MinIO
# Pin these image tags in production; `latest` is convenient only for local development.
MINIO_IMAGE_TAG=latest
MINIO_MC_IMAGE_TAG=latest
MINIO_ROOT_USER=xbrl_minio
MINIO_ROOT_PASSWORD=xbrl_minio_dev_password
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
XBRL_OBJECT_STORE_BACKEND=s3
XBRL_OBJECT_STORE_ENDPOINT=http://localhost:9002
XBRL_OBJECT_STORE_ACCESS_KEY=xbrl_minio
XBRL_OBJECT_STORE_SECRET_KEY=xbrl_minio_dev_password
XBRL_OBJECT_STORE_BUCKET=sec-xbrl
XBRL_OBJECT_STORE_REGION=us-east-1
XBRL_OBJECT_STORE_SECURE=false

# Parsing and storage
XBRL_ARROW_BATCH_ROWS=50000
XBRL_PARQUET_COMPRESSION=zstd
XBRL_PARQUET_COMPRESSION_LEVEL=6
XBRL_ARELLE_VALIDATE_XBRL=true
XBRL_ARELLE_VALIDATE_EFM=false
XBRL_ARELLE_PLUGIN_PATHS=
XBRL_ARELLE_CACHE_DIR=./data/cache/arelle
XBRL_ARELLE_TAXONOMY_PACKAGES_DIR=./data/taxonomy-packages
XBRL_ARELLE_OFFLINE=false
XBRL_ARELLE_ALLOWED_TAXONOMY_HOSTS=www.sec.gov,xbrl.sec.gov,xbrl.fasb.org,xbrl.ifrs.org,www.xbrl.org,www.esma.europa.eu,www.ifrs.org,disclosure.edinet-fsa.go.jp,disclosure2dl.edinet-fsa.go.jp

# Job worker
XBRL_WORKER_ID=local-worker
XBRL_WORKER_POLL_SECONDS=2
XBRL_WORKER_LOCK_TIMEOUT_SECONDS=900
XBRL_WORKER_MAX_ATTEMPTS=5
XBRL_WORKER_METRICS_HOST=127.0.0.1
XBRL_WORKER_METRICS_PORT=9091

# API
XBRL_API_HOST=127.0.0.1
XBRL_API_PORT=8080

# Optional local monitoring profile
PROMETHEUS_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Resource budgets (bytes unless stated otherwise). Tune using a representative corpus.
XBRL_DOWNLOAD_MAX_BYTES=34359738368
XBRL_RESPONSE_MAX_BYTES=67108864
XBRL_ZIP_MAX_MEMBERS=10000
XBRL_ZIP_MAX_DIRECTORY_BYTES=67108864
XBRL_ZIP_MAX_MEMBER_BYTES=68719476736
XBRL_ZIP_MAX_TOTAL_BYTES=137438953472
XBRL_ZIP_MAX_COMPRESSION_RATIO=200
XBRL_FILING_MAX_MEMBERS=1000
XBRL_FILING_MAX_BYTES=536870912
XBRL_RETAIN_FILING_SOURCE_FILES=true
# Required: raw deletion is no longer performed by ingestion.
XBRL_RECONCILIATION_MAX_ROWS=50000
XBRL_RECONCILIATION_MAX_BYTES=16777216
XBRL_ARROW_BATCH_BYTES=33554432
XBRL_EXTRACTION_MAX_BYTES=536870912
XBRL_ARELLE_TIMEOUT_SECONDS=600
# Native address-space enforcement on Linux; use Docker's memory budget on macOS/Windows.
XBRL_ARELLE_MEMORY_LIMIT_BYTES=2147483648
# Successful extractions per warm Arelle child process before it is replaced.
XBRL_ARELLE_CHILD_MAX_TASKS=20
WORKER_MEMORY_LIMIT=4g
API_MEMORY_LIMIT=2g

# API queries use a separate, bounded read-only connection.
XBRL_API_MAX_CONCURRENCY=4
XBRL_API_QUERY_TIMEOUT_SECONDS=30
XBRL_API_QUERY_MAX_MEMORY_BYTES=536870912
XBRL_API_QUERY_MAX_ROWS=5000000
XBRL_API_QUERY_MAX_BYTES=1073741824
XBRL_API_RESULT_MAX_BYTES=16777216
# Required in production; supply through your secret manager/environment, not source control.
# XBRL_API_KEY=<at least 32 random characters>
# XBRL_API_CLICKHOUSE_USERNAME=xbrl_api
# XBRL_API_CLICKHOUSE_PASSWORD=<reader password>

# Dedicated API health-check identity; provision before deploying the API environment split.
XBRL_API_POSTGRES_DSN=postgresql+asyncpg://xbrl_api:xbrl_api_dev_password@postgres:5432/xbrl_control
# Application data/scratch reserve. Remote database/object-store volumes need separate monitoring.
XBRL_DISK_RESERVE_BYTES=5368709120

# A company's series rebuild runs this many seconds after the first filing that asks for it.
XBRL_SERIES_REBUILD_DELAY_SECONDS=60

# Least-privilege service identities (ops/provision/provision_identities.sh and
# minio-init create them; Compose workers use them). Replace in production.
XBRL_WORKER_POSTGRES_PASSWORD=xbrl_worker_dev_password
XBRL_API_POSTGRES_PASSWORD=xbrl_api_dev_password
XBRL_WRITER_CLICKHOUSE_PASSWORD=xbrl_writer_dev_password
XBRL_WORKER_OBJECT_STORE_ACCESS_KEY=xbrl_worker
XBRL_WORKER_OBJECT_STORE_SECRET_KEY=xbrl_worker_dev_password

# Daily-index discovery refetches a stored company's SEC submissions after this many days.
XBRL_COMPANY_REFRESH_DAYS=30

# A worker job that finds the SEC egress lock held elsewhere is retried after this delay.
XBRL_SEC_EGRESS_BUSY_RETRY_SECONDS=60
# ...and goes dead after this long since its first deferral.
XBRL_SEC_EGRESS_MAX_DEFER_SECONDS=21600
# How often the SEC egress lock holder checks its lock connection.
XBRL_SEC_EGRESS_CHECK_SECONDS=30
