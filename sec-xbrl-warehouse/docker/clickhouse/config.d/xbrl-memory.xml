<?xml version="1.0"?>
<!--
  Memory and retention settings for the 4 GiB ClickHouse container.

  ClickHouse's server-wide limit is 0.9 x the container limit (3.6 GiB), and every
  query, merge and cache counts against it. Two defaults made unrelated queries fail
  with MEMORY_LIMIT_EXCEEDED (code 241):

  - system.metric_log (and query_metric_log) have about a thousand columns. Each
    background merge of metric_log peaked at 3.1 GiB, and whatever query ran during
    that second was killed. The warehouse exports its own Prometheus metrics, so
    both logs are turned off.
  - Cache defaults (5-8 GiB each) are larger than the container itself.

  Other system logs had no retention; trace_log alone reached 130 million rows.
  trace_log (sampling profiler) is turned off, text_log keeps information and
  above, and the server log files rotate at 50 MB x 3 (the image default is
  1000 MB x 10, which grew to 1 GB on this volume).
-->
<clickhouse>
    <metric_log remove="1"/>
    <query_metric_log remove="1"/>

    <trace_log remove="1"/>
    <text_log>
        <level>information</level>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>
    <query_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></query_log>
    <part_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></part_log>
    <processors_profile_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></processors_profile_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></asynchronous_metric_log>

    <logger>
        <level>information</level>
        <size>50M</size>
        <count>3</count>
    </logger>

    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>268435456</uncompressed_cache_size>
    <primary_index_cache_size>268435456</primary_index_cache_size>
    <index_mark_cache_size>134217728</index_mark_cache_size>
    <vector_similarity_index_cache_size>67108864</vector_similarity_index_cache_size>
</clickhouse>
